# URL de la API, SIN barra al final (ej. https://back-facturas-production.up.railway.app).
#
# Dejar vacía en desarrollo local: el proxy de vite.config.js ya redirige
# /panel y /api hacia localhost:3000, no hace falta esta variable ahí.
#
# Es obligatoria en producción SI el panel se despliega en un dominio distinto
# al de la API (por ejemplo, cada uno como su propio servicio en Railway).
# Vite solo la incluye en el build si el nombre empieza con VITE_.
VITE_API_URL=
